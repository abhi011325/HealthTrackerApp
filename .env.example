# Copy to .env.local (ignored by git). Both values come from Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Only for scripts/, never shipped to the app. Either the legacy service_role JWT or a new sb_secret_ key works:
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
